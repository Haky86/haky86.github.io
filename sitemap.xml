---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign valid_pages = site.pages | where_exp: "item", "item.sitemap != false" %}
  {% for page in valid_pages %}
    {% unless page.url contains '.css' or page.url contains '.js' or page.url contains '.json' or page.url contains '.txt' or page.url contains '.xml' %}
    <url>
      <loc>{{ page.url | absolute_url | xml_escape }}</loc>
      <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
      <changefreq>weekly</changefreq>
      <priority>0.8</priority>
    </url>
    {% endunless %}
  {% endfor %}
  {% for post in site.posts %}
    <url>
      <loc>{{ post.url | absolute_url | xml_escape }}</loc>
      <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
      <changefreq>weekly</changefreq>
      <priority>0.8</priority>
    </url>
  {% endfor %}
</urlset>
