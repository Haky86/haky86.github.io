---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign search_pages = site.pages | where_exp: "item", "item.sitemap != false" %}
  {% assign search_posts = site.posts %}
  {% assign all_items = search_pages | concat: search_posts %}
  
  {% for item in all_items %}
    {% if item.url != "/search.json" and item.url != "/sitemap.xml" %}
    <url>
      <loc>{{ item.url | absolute_url }}</loc>
      {% if item.date %}
      <lastmod>{{ item.date | date_to_xmlschema }}</lastmod>
      {% else %}
      <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
      {% endif %}
      <changefreq>{% if item.changefreq %}{{ item.changefreq }}{% else %}weekly{% endif %}</changefreq>
      <priority>{% if item.priority %}{{ item.priority }}{% else %}0.8{% endif %}</priority>
    </url>
    {% endif %}
  {% endfor %}
</urlset>
