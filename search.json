---
layout: null
permalink: /search.json
---
[
  {% assign search_pages = site.pages | where_exp: "item", "item.search != false" | where_exp: "item", "item.title != nil" %}
  {% for page in search_pages %}
    {
      "title": {{ page.title | jsonify }},
      "type": "Page",
      "url": {{ page.url | relative_url | jsonify }},
      "content": {{ page.content | strip_html | strip_newlines | replace: '  ', ' ' | jsonify }}
    }{% if forloop.last == false or site.posts.size > 0 %},{% endif %}
  {% endfor %}
  {% for post in site.posts %}
    {
      "title": {{ post.title | jsonify }},
      "type": "Post",
      "url": {{ post.url | relative_url | jsonify }},
      "content": {{ post.content | strip_html | strip_newlines | replace: '  ', ' ' | jsonify }}
    }{% if forloop.last == false %},{% endif %}
  {% endfor %}
]
