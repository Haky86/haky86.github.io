---
layout: null
---
[
  {% assign search_pages = site.pages | where_exp: "item", "item.search != false" %}
  {% assign search_posts = site.posts %}
  {% assign all_items = search_pages | concat: search_posts %}
  {% assign first_item = true %}
  {% for item in all_items %}
    {% if item.title and item.url != "/search.json" %}
      {% assign raw_slug = item.slug | default: item.url | replace: "/", " " | replace: ".html", "" | strip %}
      {% if raw_slug != "" %}
        {% assign slug_str = raw_slug | slugify %}
      {% else %}
        {% assign slug_str = "home" %}
      {% endif %}
      {% assign keywords_array = slug_str | split: "-" %}
      {% if first_item %}{% assign first_item = false %}{% else %},{% endif %}
      {
        "title": {{ item.title | jsonify }},
        "url": {{ item.url | relative_url | jsonify }},
        "slug": {{ item.url | jsonify }},
        "type": {% if item.date %}"post"{% else %}"page"{% endif %},
        "keywords": [
          {% for word in keywords_array %}
            {% if word != "" %}
              {{ word | jsonify }}{% unless forloop.last %},{% endunless %}
            {% endif %}
          {% endfor %}
        ]
      }
    {% endif %}
  {% endfor %}
]
